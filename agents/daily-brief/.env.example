# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
BRIEF_MODEL=claude-opus-5

# --- The brief --------------------------------------------------------------
BRIEF_RECIPIENT=Ryan                 # first name; used in the prompt only
BRIEF_TIMEZONE=Europe/Amsterdam
BRIEF_LANGUAGE=en                    # en | nl
BRIEF_BRAND=AetherLink               # "Made for you by …"
BRIEF_SIGNOFF=Aether Link            # "With love from …" (initials become the circled letters: Ⓐ Ⓛ)
BRIEF_OUT_DIR=out                    # where brief-YYYY-MM-DD.html, latest.html and the JSON land
BRIEF_ARTWORK=on                     # on | off  (public-domain painting from the Art Institute of Chicago)
# BRIEF_LOOKBACK_HOURS=24            # default 24, 72 on Mondays
# BRIEF_MAX_TURNS=40

# --- GitLab (self-hosted or gitlab.com) --------------------------------------
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-...               # personal access token, scope: read_api
# GITLAB_PROJECTS=group/agent-lab,group/training-site   # comma list; defaults to recently active projects

# --- Jira + Confluence ---------------------------------------------------------
ATLASSIAN_KIND=server                # cloud | server   (server = Data Center with a personal access token)
JIRA_URL=https://jira.example.com    # cloud: https://yourorg.atlassian.net
JIRA_TOKEN=...                       # cloud: API token; server: personal access token
# JIRA_EMAIL=you@example.com         # cloud only (basic auth = email:token)
# JIRA_PROJECTS=AL,OPS               # scope for recent activity; defaults to the recipient's own tickets
# JIRA_JQL_SCOPE=project = AL AND component = agent   # overrides JIRA_PROJECTS

CONFLUENCE_URL=https://confluence.example.com   # cloud: https://yourorg.atlassian.net/wiki
# CONFLUENCE_TOKEN=...               # defaults to JIRA_TOKEN
# CONFLUENCE_EMAIL=...               # defaults to JIRA_EMAIL
# CONFLUENCE_SPACES=AL,ENG           # defaults to pages you contributed to, mention you, or you watch

# --- Outlook via Microsoft Graph ------------------------------------------------
# App registration with application permissions Calendars.Read (and Mail.Read for the inbox tool), admin-consented.
MS_TENANT_ID=...
MS_CLIENT_ID=...
MS_CLIENT_SECRET=...
MS_USER=ryan@example.com             # the mailbox whose calendar is read
# MS_ACCESS_TOKEN=...                # alternative for local testing: paste a delegated token instead of the three above
# OUTLOOK_INCLUDE_MAIL=false         # true adds the unread-inbox tool
