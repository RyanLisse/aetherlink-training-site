{
  "name": "aetherlink-daily-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily brief agent: reads GitLab, Jira, Confluence and Outlook and writes a Dia-style brief as a self-contained HTML artifact.",
  "scripts": {
    "brief": "tsx src/main.ts",
    "brief:sample": "tsx src/main.ts --sample",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
